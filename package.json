{
  "name": "back-end-buvio",
  "version": "1.0.0",
  "description": "Back End for the Buvio project",
  "author": "Buvio",
  "license": "MIT",
  "main": "src/index.ts",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "start": "bun dist/index.js",
    "start:dev": "bun --watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "test": "jest",
    "db:generate": "kysely-codegen --dialect postgres --out-file ./src/repositories/database/models.ts",
    "db:migrate:up": "bun src/repositories/database/run-migrations.ts up",
    "db:migrate:down": "bun src/repositories/database/run-migrations.ts down",
    "db:seed": "bun scripts/seed-dev.ts",
    "graphql:generate": "graphql-codegen --config src/graphql/codegen.yaml && bun run format",
    "graphql:generate:watch": "graphql-codegen -w --config src/graphql/codegen.yaml"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@apollo/subgraph": "^2.5.6",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@google-cloud/logging-bunyan": "^5.0.1",
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^10.0.8",
    "body-parser": "^1.20.3",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-request-context": "^1.0.1",
    "firebase": "^10.8.1",
    "firebase-admin": "^12.0.0",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.0",
    "joi": "^17.12.2",
    "kysely": "^0.27.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "^0.7.1",
    "@faker-js/faker": "^8.0.0",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript": "4.0.6",
    "@graphql-codegen/typescript-resolvers": "4.0.6",
    "@graphql-tools/mock": "^9.0.0",
    "@parcel/watcher": "^2.4.1",
    "@testcontainers/postgresql": "^10.9.0",
    "@types/bunyan": "^1.8.11",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.18.1",
    "git-commit-msg-linter": "^5.0.4",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.11.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "validate-branch-name": "^1.3.0"
  },
  "overrides": {
    "jwks-rsa/jose": "^4.15.5",
    "cookie": "^0.7.2",
    "braces": "^3.0.3"
  },
  "_dependencyNotes": {
    "overrides": "Transitive packages pinned to a patched version: jose <4.15.5 (JWE decompression DoS, reached through firebase-admin token verification via jwks-rsa), cookie <0.7.0 (out-of-bounds characters), braces <3.0.3 (ReDoS). The jose entry is scoped to jwks-rsa on purpose: a global override also drags @graphql-tools/prisma-loader's jose ^5 down to 4.x and breaks graphql-codegen. Re-check whether these are still needed on each dependency upgrade.",
    "ts-node": "Only used by ts-jest's type checking path; the application itself runs TypeScript through bun.",
    "runtime": "bun runs both the source (development, migrations) and the compiled output (production). tsc is kept for the build and for typechecking, which bun does not do."
  },
  "validate-branch-name": {
    "pattern": "^(master|main|develop){1}$|^(feat|feature|chore|fix|hotfix|release)/.+$",
    "errorMsg": "The branch name is not correct. The branch name should follow the following pattern : ^(master|main|develop){1}$|^(feat|feature|chore|fix|hotfix|release)/.+$"
  }
}
