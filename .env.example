# Copy to .env and fill in. docker compose refuses to start without
# POSTGRES_PASSWORD, and the server refuses to boot in a non-development
# environment without CORS_ORIGIN (an unset value makes CORS answer every
# origin with `*`).

NODE_ENV=development
PORT=4000

# Local database credentials used by docker compose.
POSTGRES_USER=buvio
POSTGRES_PASSWORD=
POSTGRES_DB=buvio
# Host port the development database is published on, loopback only. Defaults
# to 55432 because 5432 is usually taken by another project.
POSTGRES_HOST_PORT=55432

# Only needed when running the server outside docker compose.
# DATABASE_URL=postgresql://buvio:password@localhost:5432/buvio

# Comma-separated list of allowed origins. Required outside development.
CORS_ORIGIN=http://localhost:8081

# Introspection + the Apollo sandbox landing page. Ignored in production.
GRAPHQL_SANDBOX=true

# Per-document cost ceilings, enforced before any resolver runs.
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_FIELDS=300

# Per-IP fixed window in front of /graphql. In-memory, so the budget is per
# process: with N instances the effective limit is N x RATE_LIMIT_MAX.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Firebase (identity provider)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_CLIENT_EMAIL=
FIREBASE_CREDENTIALS_PRIVATE_KEY=
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_STORAGE_BUCKET=
FIREBASE_CLIENT_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_APP_ID=

# Google Cloud (production logging + storage)
GCP_PROJECT_ID=
GCP_CREDENTIALS_CLIENT_ID=
GCP_CREDENTIALS_CLIENT_EMAIL=
GCP_CREDENTIALS_PRIVATE_KEY=
GCP_CREDENTIALS_TYPE=
GCP_STORAGE_BUCKET_NAME=

# Cloudflare R2 (avatars and crests). The app uploads straight to the bucket
# with a pre-signed URL, so the server only ever signs and never sees the
# bytes. Leave these empty to run without pictures: the upload mutations fail,
# everything else works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public host the bucket is read from, no trailing slash: a custom domain in
# production, the r2.dev URL for a scratch bucket.
R2_PUBLIC_BASE_URL=

# Used when running commands outside docker compose (migrations, scripts).
DATABASE_URL=postgresql://buvio:password@localhost:55432/buvio
